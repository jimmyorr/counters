{
  "name": "counters",
  "version": "0.0.16",
  "description": "Minimalist score keeping app",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "release": "npm version patch --no-git-tag-version && npm run build",
    "preview": "vite preview",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "android": "npm run build && npx cap sync android && npx cap open android"
  },
  "keywords": [
    "score",
    "counter",
    "keeper",
    "webapp",
    "vanilla"
  ],
  "author": "Jimmy Orr",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-firebase/analytics": "^8.3.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/preferences": "^8.0.1"
  }
}
