{
  "name": "counters",
  "version": "0.1.27",
  "description": "Counters is a minimalist app designed for counting things, like scores in games.",
  "main": "index.html",
  "scripts": {
    "predev": "node scripts/sync-metadata.js",
    "prebuild": "node scripts/check-clean-source.js --mode=source && node scripts/sync-metadata.js",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run lint",
    "test:e2e": "playwright test --grep-invert @contrast",
    "test:contrast": "playwright test --grep @contrast",
    "release": "node scripts/release.js",
    "preview": "vite preview",
    "ios": "npx cap sync ios && npx cap open ios",
    "android": "npx cap sync android && npx cap open android",
    "promo:sheet": "node scripts/promo.js sheet",
    "promo:stills": "node scripts/promo.js stills",
    "promo:video": "node scripts/promo.js video",
    "promo:artwork": "node scripts/promo.js artwork",
    "promo:open": "node scripts/promo.js open",
    "promo:view": "node scripts/promo.js view"
  },
  "keywords": [
    "score",
    "tracker",
    "counter",
    "game",
    "boardgame",
    "tally",
    "dice",
    "timer",
    "points",
    "life",
    "calculator",
    "habit",
    "shuffle",
    "mtg",
    "dnd"
  ],
  "author": "Jimmy Orr",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-firebase/analytics": "^8.3.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "canvas-confetti": "^1.9.4"
  }
}
